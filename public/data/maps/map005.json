e Far side\u2026 I think the real song is still in there."},{"c":"msg","face":"kaze","name":"Kaze","text":"Shift, listen at each bell, then ring them low to high. Easy."},{"c":"msg","face":"mouse","name":"Bell Mouse","text":"Squeak. If you ring the true scale, I will come with you, I promise!"},{"c":"set","sw":"sq04_on","v":true},{"c":"quest","id":"sq04","stage":0,"done":false,"quiet":false}]},{"cond":{"sw":"sq04_on","nsw":"sq04_solved"},"g":{"sheet":"mouse","dir":"down"},"trigger":"action","list":[{"c":"msg","face":"mouse","name":"Bell Mouse","text":"Listen at each bell from the Far side. Ring them from the lowest note to the highest!"}]},{"cond":{"sw":"sq04_solved","nsw":"sq04_done"},"g":{"sheet":"mouse","dir":"down"},"trigger":"action","list":[{"c":"msg","face":"mouse","name":"Bell Mouse","text":"That was it! That was the song! Squeak! Oh, thank you!"},{"c":"sqreward","id":"sq04"},{"c":"exp","n":20},{"c":"msg","face":"mouse","name":"Bell Mouse","text":"I will be a neighbour to you now. Call on me, and I will ring for you."},{"c":"set","sw":"sq04_done","v":true},{"c":"quest","id":"sq04","stage":1,"done":true,"quiet":false}]},{"cond":{"sw":"sq04_done"},"g":{"sheet":"mouse","dir":"down"},"trigger":"action","list":[{"c":"msg","face":"mouse","name":"Bell Mouse","text":"Ding, ding! The bells are singing right now. Do you hear them?"}]}]}],"lights":[{"x":11,"y":19,"r":6},{"x":7,"y":8,"r":4},{"x":16,"y":8,"r":4},{"x":3,"y":10,"r":4},{"x":20,"y":10,"r":4},{"x":10,"y":17,"r":4},{"x":13,"y":17,"r":4},{"x":9,"y":12,"r":4},{"x":14,"y":12,"r":4}],"encounter":{"region":3,"zone":"z04"},"counters":[],"noShift":false,"dyn":[],"bg":null}