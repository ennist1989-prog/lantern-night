,"text":"The bell hangs silent over the two of them. For a moment it is enough."}],"marker":false}]},{"id":5,"x":13,"y":12,"realm":"far","pages":[{"cond":{"nself":"A"},"g":{"obj":"chest"},"trigger":"action","list":[{"c":"se","name":"pickup"},{"c":"item","id":"shrine_bell_clapper","n":1,"quiet":false},{"c":"self","k":"A"}]},{"cond":{"self":"A"},"g":{"obj":"chest"},"trigger":"action","list":[{"c":"msg","face":null,"name":null,"text":"The chest is empty."}]}]},{"id":6,"x":3,"y":3,"realm":"both","pages":[{"cond":{"nself":"A"},"g":{"obj":"chest"},"trigger":"action","list":[{"c":"se","name":"pickup"},{"c":"item","id":"honey","n":2,"quiet":false},{"c":"item","id":"lantern_oil","n":2,"quiet":false},{"c":"self","k":"A"}]},{"cond":{"self":"A"},"g":{"obj":"chest"},"trigger":"action","list":[{"c":"msg","face":null,"name":null,"text":"The chest is empty."}]}]},{"id":7,"x":4,"y":3,"realm":"both","pages":[{"cond":{"nsw":"drift_gone"},"g":{"obj":"block_sand"},"trigger":"action","list":[{"c":"msg","face":null,"name":null,"text":"Sand has drifted against the wall in a smooth heap, hiding something that glints. A good gust would clear it."}],"ft":"wind_object","fieldList":[{"c":"se","name":"strange"},{"c":"shake","power":1,"ms":400},{"c":"msg","face":null,"name":null,"text":"A gust sweeps the sand away!"},{"c":"set","sw":"drift_gone","v":true}]}]},{"id":8,"x":3,"y":4,"realm":"both","pages":[{"cond":{"nsw":"drift_gone"},"g":{"obj":"block_sand"},"trigger":"action","list":[{"c":"msg","face":null,"name":null,"text":"Sand has drifted against the wall in a smooth heap, hiding something that glints. A good gust would clear it."}],"ft":"wind_object","fieldList":[{"c":"se","name":"strange"},{"c":"shake","power":1,"ms":400},{"c":"msg","face":null,"name":null,"text":"A gust sweeps the sand away!"},{"c":"set","sw":"drift_gone","v":true}]}]},{"id":9,"x":8,"y":5,"realm":"near","pages":[{"cond":{"nlock":"L07"},"g":{"sheet":"keeper","dir":"down","nofar":true},"trigger":"action","list":[{"c":"msg","face":null,"name":null,"text":"Under the great bell, a robed figure kneels. The great bell hangs silent and strangely light."},{"c":"msg","face":"kaze","name":"Kaze","text":"Look, Mio \u2014 the clapper\u2019s gone. The Keeper won\u2019t even look up. It must be somewhere on the Far Shore. Shift and search this hall."}]},{"cond":{"lock":"L07"},"g":{"sheet":"keeper","dir":"down","nofar":true},"trigger":"action","list":[{"c":"msg","face":null,"name":null,"text":"Under the great bell, a robed figure kneels. Bronze armor weighs on his shoulders like grief."},{"c":"msg","face":null,"name":null,"text":"A neat paper name-seal is tied to the bell\u2019s clapper-rope. The knot and the brushstrokes look just like the one on the scarecrow."},{"c":"if","cond":{"nlvl":6},"then":[{"c":"msg","face":"kaze","name":"Kaze","text":"Mio\u2026 I can feel how strong he is. Level 6 would be safer. The Post here will heal us \u2014 and the shrine below has spirits to practise on."}]},{"c":"choice","opts":["Face the Bell-Keeper","Wait \u2014 prepare first"],"br":[[{"c":"checkpoint","boss":true},{"c":"msg","face":"keeper","name":"Bell-Keeper","text":"None\u2026 shall ring\u2026 the Bell."},{"c":"msg","face":"mio","name":"Mio","text":"Priest Ren? Is that you? The village needs the Bell. The lanterns won\u2019t light."},{"c":"msg","face":"keeper","name":"Bell-Keeper","text":"If it rings, they all go. All of them. She goes. My Hana goes. I cannot\u2026 I will not send her."},{"c":"msg","face":"kaze","name":"Kaze","text":"Oh no. He\u2019s been holding the whole shore together out of grief."},{"c":"msg","face":"kaze","name":"Kaze","text":"So we can\u2019t just smash our way through, can we."},{"c":"msg","face":"mio","name":"Mio","text":"No. We can\u2019t. Not like that."},{"c":"tutorial","id":"boss","text":"Boss tip: hit its weakness to break the Veil \u2014 then Parley or Send. The \u26a0 telegraph lands next round: Guard or break it with a Stun/Unveil.","ms":12000},{"c":"battle","troop":"boss_bell_keeper","boss":true,"noEscape":true,"win":[{"c":"msg","face":null,"name":null,"text":"The bronze armor falls away piece by piece, like autumn leaves. A tired priest remains, kneeling."},{"c":"msg","face":"keeper","name":"Priest Ren","text":"I could not\u2026 let her go. I did not want to be alone in the quiet."},{"c":"msg","face":"mio","name":"Mio","text":"You aren\u2019t alone. You never were. Hana waited, too. Let us ring it together."},{"c":"me","name":"fanfare"},{"c":"shake","power":2,"ms":800},{"c":"set","sw":"boss_done","v":true},{"c":"item","id":"wellkeeper_pebble","n":1,"quiet":false},{"c":"quest","id":"main","stage":6,"done":true,"quiet":false}],"lose":[{"c":"abort"}]},{"c":"flash","color":16777215,"ms":800},{"c":"se","name":"bell"},{"c":"wait","ms":900},{"c":"se","name":"bell"},{"c":"narrate","lines":["The Bell rang once, and the valley breathed out.","Across Ashiro, every lantern caught fire at once, and every spirit that had waited too long was finally able to go home.","Priest Ren lit the last lantern himself, for the daughter who had never really left."]},{"c":"msg","face":null,"name":null,"text":"Then the paper seal on the clapper-rope tightens itself, knot by knot, and the bell goes silent again."},{"c":"msg","face":"kaze","name":"Kaze","text":"That isn\u2019t a broken bell, Mio. That\u2019s a hand."},{"c":"narrate","lines":["Night 3. Six nights have become five, and the calendar by Sachi\u2019s door has one more day crossed out."]},{"c":"narrate","lines":["Mio, Kaze and Daigo had only reached the first shore.","But the Bell was ringing again, and that was enough to begin."]},{"c":"end"}],[]],"cancel":-1}]}]},{"id":10,"x":6,"y":10,"realm":"far","pages":[{"cond":null,"g":{"sheet":"lantern2","dir":"down"},"trigger":"action","list":[],"enemy":{"troop":"tr_candle_spirit_candle_spirit_bell_mouse","aggro":3,"chase":true,"range":1,"spd":260}}]},{"id":11,"x":13,"y":9,"realm":"far","pages":[{"cond":null,"g":{"sheet":"kettle","dir":"down"},"trigger":"action","list":[],"enemy":{"troop":"tr_gloam_bat_ofuda_moth","aggro":3,"chase":true,"range":1,"spd":260}}]},{"id":12,"x":10,"y":8,"realm":"far","pages":[{"cond":null,"g":{"sheet":"villager4","dir":"down"},"trigger":"action","list":[{"c":"msg","face":null,"name":null,"text":"A hollowed villager stands here, face blank as a wiped slate. Mio holds up the Lantern and the figure murmurs a few words."},{"c":"msg","face":null,"name":null,"text":"It stands as if waiting at a ferry post. A boatman\u2019s widow, still counting the boats."},{"c":"set","sw":"sq03_h3","v":true},{"c":"if","cond":{"sw":"sq03_m3"},"then":[{"c":"msg","face":null,"name":null,"text":"The name has already returned to the register."}]}]}]},{"id":13,"x":11,"y":11,"realm":"far","pages":[{"cond":null,"g":{"sheet":"villager1","dir":"down"},"trigger":"action","list":[{"c":"msg","face":null,"name":null,"text":"A hollowed villager stands here, face blank as a wiped slate. Mio holds up the Lantern and the figure murmurs a few words."},{"c":"msg","face":null,"name":null,"text":"It mends an invisible net with quick, careful hands. A net-mender."},{"c":"set","sw":"sq03_h4","v":true},{"c":"if","cond":{"sw":"sq03_m4"},"then":[{"c":"msg","face":null,"name":null,"text":"The name has already returned to the register."}]}]}]},{"id":14,"x":10,"y":6,"realm":"near","pages":[{"cond":null,"g":null,"trigger":"action","list":[{"c":"msg","face":null,"name":null,"text":"A shrine bell hangs here, struck by a wooden mallet on a chain. On the Near Shore it gives a sour clang. The note is wrong. Shift to hear the true one."}]}]},{"id":15,"x":10,"y":6,"realm":"far","pages":[{"cond":null,"g":null,"trigger":"action","list":[{"c":"se","name":"bell"},{"c":"msg","face":null,"name":null,"text":"The bell rings a middle, warm note. The Far Shore remembers the true pitch."},{"c":"if","cond":{"sw":"sq04_on","nsw":"sq04_done"},"then":[{"c":"if","cond":{"v":["bells","==",1]},"then":[{"c":"var","name":"bells","op":"+=","v":1},{"c":"if","cond":{"v":["bells",">=",3]},"then":[{"c":"msg","face":null,"name":null,"text":"Three notes, low to high, and the three bells hum together. Something small scurries out of the tower, delighted."},{"c":"se","name":"powerup"},{"c":"flash","color":16771488,"ms":400},{"c":"set","sw":"sq04_solved","v":true}],"else":[{"c":"msg","face":null,"name":null,"text":"The chime holds. One note is right. The next?"}]}],"else":[{"c":"var","name":"bells","op":"=","v":0},{"c":"msg","face":null,"name":null,"text":"A wrong order; the chime fades and the bells go quiet. Start again from the lowest."}]}]}]}]}],"lights":[{"x":5,"y":10,"r":6},{"x":5,"y":4,"r":5},{"x":12,"y":4,"r":5},{"x":8,"y":7,"r":5},{"x":4,"y":8,"r":5},{"x":13,"y":8,"r":5}],"encounter":{"region":3,"zone":"z05"},"counters":[],"noShift":false}