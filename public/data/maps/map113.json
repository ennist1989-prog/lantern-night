"realm":"both","pages":[{"cond":null,"g":{"obj":"lantern_post"},"trigger":"action","list":[{"c":"post"}],"marker":true}]},{"id":5,"x":15,"y":23,"realm":"both","pages":[{"cond":{"nsw":"grove_intro"},"g":null,"trigger":"auto","list":[{"c":"msg","face":null,"name":null,"text":"Mist hangs between the trees, so thick the Near Shore seems to end a few steps ahead."},{"c":"msg","face":"kaze","name":"Kaze","text":"On this Shore the paths stop. Shift, and they appear. Stay close."},{"c":"set","sw":"grove_intro","v":true}]}]},{"id":6,"x":17,"y":20,"realm":"near","pages":[{"cond":{"nsw":"traveller_saved"},"g":{"sheet":"villager2","dir":"left"},"trigger":"action","list":[{"c":"msg","face":"villager2","name":"Lost Traveller","text":"Every path here bends back to this clearing. I came to leave a lantern for my father at the Crossing. That was\u2026 days ago? I can\u2019t tell."},{"c":"msg","face":"mio","name":"Mio","text":"There are paths on the other Shore. You can\u2019t see them, can you?"},{"c":"msg","face":"villager2","name":"Lost Traveller","text":"Only mist. If you could make a path stay put long enough for me to see it, I\u2019d follow it anywhere."},{"c":"set","sw":"traveller_met","v":true}]}]},{"id":7,"x":25,"y":3,"realm":"far","pages":[{"cond":null,"g":{"sheet":"priest","dir":"down","tint":13623551},"trigger":"action","list":[{"c":"msg","face":"priest","name":"Heron Keeper","text":"A Lantern. Then the old Shrine Bell really rang. I keep the guide stone at the top of this grove; it shows the way out to those who stand on the wrong Shore."},{"c":"if","cond":{"nsw":"traveller_saved"},"then":[{"c":"msg","face":"priest","name":"Heron Keeper","text":"But the stone only lights a Far path. A Near traveller cannot walk it\u2026 unless someone holds the Far path in place for them."},{"c":"msg","face":"mio","name":"Mio","text":"An Anchor. I can do that."}],"else":[{"c":"msg","face":"priest","name":"Heron Keeper","text":"You did well with the traveller. Keep the Anchor Stone. It will not drift, not even on the river."}]}]}]},{"id":8,"x":15,"y":2,"realm":"far","pages":[{"cond":null,"g":null,"trigger":"action","list":[{"c":"if","cond":{"nsw":"traveller_saved"},"then":[{"c":"msg","face":null,"name":null,"text":"The guide stone. A faint path of light runs down from it, flickering in and out of the world."},{"c":"if","cond":{"sw":"traveller_met"},"then":[{"c":"if","cond":{"sw":"anchor_learned"},"then":[{"c":"choice","opts":["Anchor it (8 Lumen)","Leave it"],"br":[[{"c":"lumen","n":-8},{"c":"se","name":"powerup"},{"c":"flash","color":16769184,"ms":250},{"c":"se","name":"bell"},{"c":"flash","color":16769184,"ms":400},{"c":"msg","face":null,"name":null,"text":"The path of light from the guide stone hardens and stays. For a long moment both Shores share one road through the mist."},{"c":"shift","to":"near"},{"c":"msg","face":"villager2","name":"Lost Traveller","text":"There! A road! I can see it! Thank you, Lantern girl!"},{"c":"msg","face":null,"name":null,"text":"Footsteps hurry away along the held path, then fade. The mist thins a little."},{"c":"shift","to":"far"},{"c":"msg","face":"priest","name":"Heron Keeper","text":"You held a whole road. Take this. The river at the Crossing drifts, and this stone does not."},{"c":"item","id":"anchor_stone","n":1,"quiet":false},{"c":"set","sw":"traveller_saved","v":true},{"c":"quest","id":"ch3","stage":3,"done":false,"quiet":false},{"c":"msg","face":"kaze","name":"Kaze","text":"The bridge at the Crossing. That\u2019s what the stone is for."}],[]],"cancel":-1}]}],"else":[{"c":"msg","face":"mio","name":"Mio","text":"Someone down in the Near clearing might need this path\u2026"}]}],"else":[{"c":"msg","face":null,"name":null,"text":"The guide stone hums. The road it shows is steady now."}]}],"ft":"anchor","fieldList":[{"c":"if","cond":{"nsw":"traveller_saved"},"then":[{"c":"if","cond":{"sw":"traveller_met"},"then":[{"c":"se","name":"bell"},{"c":"flash","color":16769184,"ms":400},{"c":"msg","face":null,"name":null,"text":"The path of light from the guide stone hardens and stays. For a long moment both Shores share one road through the mist."},{"c":"shift","to":"near"},{"c":"msg","face":"villager2","name":"Lost Traveller","text":"There! A road! I can see it! Thank you, Lantern girl!"},{"c":"msg","face":null,"name":null,"text":"Footsteps hurry away along the held path, then fade. The mist thins a little."},{"c":"shift","to":"far"},{"c":"msg","face":"priest","name":"Heron Keeper","text":"You held a whole road. Take this. The river at the Crossing drifts, and this stone does not."},{"c":"item","id":"anchor_stone","n":1,"quiet":false},{"c":"set","sw":"traveller_saved","v":true},{"c":"quest","id":"ch3","stage":3,"done":false,"quiet":false},{"c":"msg","face":"kaze","name":"Kaze","text":"The bridge at the Crossing. That\u2019s what the stone is for."}],"else":[{"c":"msg","face":null,"name":null,"text":"The path holds, but no one is waiting to walk it."}]}]}]}]},{"id":9,"x":5,"y":3,"realm":"far","pages":[{"cond":null,"g":{"sheet":"spirit","dir":"down"},"trigger":"action","list":[{"c":"msg","face":"spirit","name":"Mist Peddler","text":"Flowers, cucumbers, candles that burn without wax. Coins from the Near Shore spend the same here."},{"c":"shop","items":["flower_bundle","cucumber","marigold_petal","umeboshi","matcha","tallow_candle","ofuda_barrier","paper_crane","small_bell","ward_salt","kuzu_tonic","lantern_oil"],"name":"Mist Peddler","face":"spirit"}]}]},{"id":10,"x":21,"y":10,"realm":"far","pages":[{"cond":{"nself":"A"},"g":null,"trigger":"action","list":[{"c":"msg","face":null,"name":null,"text":"A tiny stump. If you stand still, something inside seems to be listening back."},{"c":"choice","opts":["Stand still and listen","Walk on"],"br":[[{"c":"wait","ms":1800},{"c":"se","name":"chime"},{"c":"msg","face":null,"name":null,"text":"Something answers in Mio\u2019s own voice, a heartbeat late: \u201c\u2026listen\u2026 listen\u2026\u201d A kodama!"},{"c":"battle","troop":"tr_kodama_ech